# Runtime
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000

# Use memory for a zero-dependency demo; postgres is required for durable deployments.
STORAGE_DRIVER=memory
DATABASE_URL=postgresql://nehemiah:replace-with-a-long-random-database-password@localhost:5432/nehemiah
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Docker Compose database bootstrap (fake local-development value; replace before deployment).
POSTGRES_DB=nehemiah
POSTGRES_USER=nehemiah
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# AI is optional. Development defaults to the deterministic fake provider when omitted.
# Set AI_PROVIDER=none to make AI calls return provider_not_configured.
AI_PROVIDER=fake
AI_MODEL=
AI_BASE_URL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=800
AI_DECOMPOSITION_MAX_OUTPUT_TOKENS=4000
AI_MAX_CONTEXT_MEMORY_ITEMS=20
AI_MAX_CONTEXT_SIGNALS=10
AI_TEMPERATURE=

# GitHub webhook receiver. Repository linking occurs only after verified installation discovery.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret-at-least-32-chars

# Discord app (required only by apps/discord)
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_DEV_GUILD_ID=
NEHEMIAH_API_URL=http://localhost:3000
INTERNAL_API_TOKEN=replace-with-a-random-internal-token-at-least-32-chars

# Worker
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=20
DEMO_MODE=false
