{
  "name": "@nehemiah/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "migrate": "tsx --tsconfig ../../tsconfig.runtime.json --env-file-if-exists=../../.env src/cli/migrate.ts",
    "seed": "tsx --tsconfig ../../tsconfig.runtime.json --env-file-if-exists=../../.env src/cli/seed.ts"
  },
  "dependencies": {
    "@nehemiah/github": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "pg-mem": "^3.0.5"
  }
}
